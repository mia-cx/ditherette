{
	"name": "ditherette",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types --check && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "node -e \"import('node:fs').then(fs=>{fs.rmSync('.svelte-kit/output',{recursive:true,force:true});fs.rmSync('.svelte-kit/cloudflare',{recursive:true,force:true});})\" && wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:e2e": "playwright install && playwright test",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:unit": "vitest",
		"gen": "wrangler types",
		"wasm:build": "pnpm dlx wasm-pack build crates/ditherette-wasm --target web",
		"wasm:test": "pnpm dlx wasm-pack test --node crates/ditherette-wasm",
		"wasm:test:browser": "pnpm dlx wasm-pack test --headless --chrome crates/ditherette-wasm",
		"crit:cmp": "node scripts/criterion-compare.mjs",
		"brunch:cmp": "node scripts/brunch-compare.mjs",
		"crit:resize": "node scripts/criterion-resize.mjs",
		"crit:resize:bilinear": "node scripts/criterion-resize.mjs --kernel bilinear --filter bilinear",
		"crit:resize:bilinear2": "node scripts/criterion-resize.mjs --kernel bilinear_2 --filter bilinear_2",
		"crit:resize:filters": "node scripts/criterion-resize.mjs --kernel filters",
		"crit:resize:nearest": "node scripts/criterion-resize.mjs --kernel filters --filter nearest",
		"crit:resize:nearest:tiling": "node scripts/criterion-resize.mjs --kernel filters --filter nearest --cargo-feature tiling",
		"crit:resize:row-band-tiling": "cargo bench --manifest-path crates/ditherette-wasm/Cargo.toml --features tiling --bench crit_row_band_tiling",
		"crit:resize:tiling-overhead": "cargo bench --manifest-path crates/ditherette-wasm/Cargo.toml --features tiling --bench crit_tiling_overhead",
		"crit:resize:area-resampling": "cargo bench --manifest-path crates/ditherette-wasm/Cargo.toml --bench crit_area_resampling",
		"crit:resize:nearest:aa": "node scripts/criterion-resize.mjs --kernel filters --filter nearest_aa",
		"crit:resize:nearest:aa:tiling": "node scripts/criterion-resize.mjs --kernel filters --filter nearest_aa --cargo-feature tiling",
		"crit:resize:bilinear:tiling": "node scripts/criterion-resize.mjs --kernel filters --filter bilinear --cargo-feature tiling",
		"crit:resize:trilinear": "node scripts/criterion-resize.mjs --kernel filters --filter trilinear",
		"crit:resize:trilinear:tiling": "node scripts/criterion-resize.mjs --kernel filters --filter trilinear --cargo-feature tiling",
		"crit:resize:bicubic": "node scripts/criterion-resize.mjs --kernel filters --filter bicubic",
		"crit:resize:bicubic:tiling": "node scripts/criterion-resize.mjs --kernel filters --filter bicubic --cargo-feature tiling",
		"crit:resize:lanczos2": "node scripts/criterion-resize.mjs --kernel filters --filter lanczos2",
		"crit:resize:lanczos2:tiling": "node scripts/criterion-resize.mjs --kernel filters --filter lanczos2 --cargo-feature tiling",
		"crit:resize:lanczos2-scale-aware": "node scripts/criterion-resize.mjs --kernel filters --filter lanczos2_scale_aware",
		"crit:resize:lanczos2-scale-aware:tiling": "node scripts/criterion-resize.mjs --kernel filters --filter lanczos2_scale_aware --cargo-feature tiling",
		"crit:resize:lanczos3": "node scripts/criterion-resize.mjs --kernel filters --filter lanczos3",
		"crit:resize:lanczos3:tiling": "node scripts/criterion-resize.mjs --kernel filters --filter lanczos3 --cargo-feature tiling",
		"crit:resize:lanczos3-scale-aware": "node scripts/criterion-resize.mjs --kernel filters --filter lanczos3_scale_aware",
		"crit:resize:lanczos3-scale-aware:tiling": "node scripts/criterion-resize.mjs --kernel filters --filter lanczos3_scale_aware --cargo-feature tiling",
		"crit:resize:area": "node scripts/criterion-resize.mjs --kernel filters --filter area",
		"crit:resize:area:tiling": "node scripts/criterion-resize.mjs --kernel filters --filter area --cargo-feature tiling",
		"crit:resize:box": "node scripts/criterion-resize.mjs --kernel filters --filter box",
		"crit:resize:box:tiling": "node scripts/criterion-resize.mjs --kernel filters --filter box --cargo-feature tiling",
		"crit:resize:antialias": "node scripts/criterion-resize.mjs --kernel filters --filter antialias",
		"crit:resize:antialias:tiling": "node scripts/criterion-resize.mjs --kernel filters --filter antialias --cargo-feature tiling",
		"brunch:resize": "node scripts/brunch-resize.mjs",
		"brunch:resize:nearest": "node scripts/brunch-resize.mjs --filter nearest --implementation scalar",
		"brunch:resize:nearest:tiling": "node scripts/brunch-resize.mjs --filter nearest --implementation tiling",
		"brunch:resize:bilinear": "node scripts/brunch-resize.mjs --filter bilinear --implementation scalar",
		"brunch:resize:bilinear:tiling": "node scripts/brunch-resize.mjs --filter bilinear --implementation tiling",
		"brunch:resize:area": "node scripts/brunch-resize.mjs --filter area --implementation scalar",
		"brunch:resize:area:tiling": "node scripts/brunch-resize.mjs --filter area --implementation tiling",
		"brunch:resize:box": "node scripts/brunch-resize.mjs --filter box --implementation scalar",
		"brunch:resize:box:tiling": "node scripts/brunch-resize.mjs --filter box --implementation tiling",
		"brunch:resize:bicubic": "node scripts/brunch-resize.mjs --filter bicubic --implementation scalar",
		"brunch:resize:lanczos3": "node scripts/brunch-resize.mjs --filter lanczos3 --implementation scalar",
		"bench:cmp:quick": "node scripts/benchmark-quick-compare.mjs",
		"bench:resize:shootout": "cargo run --manifest-path crates/ditherette-wasm/Cargo.toml --release --features tiling --example resize_shootout --",
		"bench:resize:wasm": "pnpm wasm:build && node scripts/benchmark-wasm-resize.mjs",
		"bench:tiling-sweep": "node scripts/benchmark-tiling-sweep.mjs",
		"bench:tiling-plot": "node scripts/plot-tiling-sweep.mjs",
		"crit:resize:bicubic2": "node scripts/criterion-resize.mjs --kernel filters --filter bicubic_2",
		"crit:cmp:bicubic2": "node scripts/criterion-compare.mjs --compare resize:bicubic:scalar --to resize:bicubic:scalar_2",
		"crit:resize:convolution_2": "node scripts/criterion-resize.mjs --kernel convolution_2",
		"crit:resize:lanczos3_2": "node scripts/criterion-resize.mjs --kernel filters --filter lanczos3_2",
		"crit:cmp:lanczos3_2": "node scripts/criterion-compare.mjs --compare resize:lanczos3:scalar --to resize:lanczos3:scalar_2"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/geist": "^5.2.8",
		"@internationalized/date": "^3.12.1",
		"@playwright/test": "^1.59.1",
		"@sveltejs/adapter-cloudflare": "latest",
		"@sveltejs/kit": "latest",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@tanstack/table-core": "^8.21.3",
		"@types/katex": "^0.16.8",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.3",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"embla-carousel-svelte": "^8.6.0",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"formsnap": "^2.0.1",
		"globals": "^17.4.0",
		"layerchart": "2.0.0-next.48",
		"mode-watcher": "^1.1.0",
		"paneforge": "^1.0.2",
		"phosphor-svelte": "^3.1.0",
		"playwright": "^1.59.1",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"shadcn-svelte": "^1.2.7",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"svelte-sonner": "^1.1.1",
		"sveltekit-superforms": "^2.30.1",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.2.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^8.0.7",
		"vitest": "^4.1.3",
		"vitest-browser-svelte": "^2.1.0",
		"wrangler": "^4.81.0"
	},
	"dependencies": {
		"@nanostores/persistent": "^1.3.4",
		"effect": "4.0.0-beta.62",
		"katex": "^0.16.45",
		"nanostores": "^1.3.0"
	}
}
