{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "ditherette",
	"compatibility_date": "2026-05-06",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true,
	"d1_databases": [
		{
			"binding": "EVENTS",
			"database_name": "ditherette-events-preview",
			"database_id": "84f2508a-8f4c-47a2-b56b-254c27151b0a",
			"migrations_dir": "migrations"
		}
	],
	"env": {
		"production": {
			"d1_databases": [
				{
					"binding": "EVENTS",
					"database_name": "ditherette-events",
					"database_id": "5a12eb0f-2495-4857-82fb-702d9aeba6d4",
					"migrations_dir": "migrations"
				}
			],
			"routes": [
				{
					"zone_name": "mia.cx",
					"custom_domain": true,
					"pattern": "ditherette.mia.cx"
				}
			]
		},
		"staging": {
			"d1_databases": [
				{
					"binding": "EVENTS",
					"database_name": "ditherette-events-preview",
					"database_id": "84f2508a-8f4c-47a2-b56b-254c27151b0a",
					"migrations_dir": "migrations"
				}
			],
			"routes": [
				{
					"zone_name": "mia.cx",
					"custom_domain": true,
					"pattern": "staging.ditherette.mia.cx"
				}
			]
		},
		"development": {
			"d1_databases": [
				{
					"binding": "EVENTS",
					"database_name": "ditherette-events-preview",
					"database_id": "84f2508a-8f4c-47a2-b56b-254c27151b0a",
					"migrations_dir": "migrations"
				}
			],
			"routes": [
				{
					"zone_name": "mia.cx",
					"custom_domain": true,
					"pattern": "development.ditherette.mia.cx"
				}
			]
		}
	}
}
